<FilesMatch \.php$>
   SetHandler "proxy:unix:/var/run/php/php8.4-fpm.sock|fcgi://localhost"
</FilesMatch>

RewriteEngine on

<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} ^/Absensi-Pegawai/.git
    RewriteRule ^ - [F,L]
</IfModule>

RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
